# BrandProof Backend Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.

# Application Server
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://brandproof.vercel.app
MAX_UPLOAD_SIZE_MB=50

# Supabase (PostgreSQL, Auth, Storage)
# Obtain these from your Supabase Project Settings -> API & Database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-secret-key-never-expose-to-browser
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-for-token-verification

# Vector Search & Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# AI Provider Settings (At least one key required if not operating in Rules-Only mode)
DEFAULT_AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key-here
GEMINI_API_KEY=AIzaSy-your-gemini-api-key-here

# Document & OCR Parsers
# On Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# On Linux/Render: /usr/bin/tesseract
TESSERACT_CMD=/usr/bin/tesseract
